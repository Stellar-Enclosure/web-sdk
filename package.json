{
  "name": "@stellar-enclosure/stellar-enclosure-web-sdk-workspace",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run permissions:verify && npm run build --workspace @stellar-enclosure/stellar-enclosure-web-shared && npm run build --workspace @stellar-enclosure/stellar-enclosure-tianquan-jianshen-react-sdk",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run build && npm run test --workspaces && npm run permissions:test",
    "lint": "npm run lint --workspaces",
    "release:check": "npm test && npm pack --workspaces --dry-run",
    "release:shared": "npm publish --workspace @stellar-enclosure/stellar-enclosure-web-shared --access public --registry https://registry.npmjs.org/",
    "release:jianshen": "npm publish --workspace @stellar-enclosure/stellar-enclosure-tianquan-jianshen-react-sdk --access public --registry https://registry.npmjs.org/",
    "permissions:verify": "node scripts/permission-manifest.mjs verify",
    "permissions:test": "node --test scripts/permissions/*.test.mjs",
    "permissions:distribution-check": "node scripts/permission-manifest.mjs verify --lock permission-toolchain.lock.json --purpose distribution"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
